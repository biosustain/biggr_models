    {
      "id": 42,
      "type": "timeseries",
      "title": "Disk I/O utilisation",
      "description": "Fraction of time the device is busy. This was checked during the 2026-08-30 incident and sat near 1%, ruling out I/O saturation.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(node_disk_io_time_seconds_total{device=~\"sd.*\"}[5m])",
          "legendFormat": "{{device}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
