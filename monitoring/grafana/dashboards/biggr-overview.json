          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Status codes",
      "description": "Note 499 = client hung up before we answered. A burst of 499s from a monitor means the monitor timed out, not that the server failed.",
      "gridPos": {
